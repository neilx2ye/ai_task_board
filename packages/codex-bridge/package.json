{
  "name": "ai-task-board-codex-bridge",
  "version": "0.7.0",
  "description": "Device-level multi-thread Codex bridge for AI Task Board",
  "type": "module",
  "types": "./dist/index.d.ts",
  "keywords": [
    "ai-task-board",
    "codex",
    "bridge",
    "cli"
  ],
  "bin": {
    "ai-task-board-codex-bridge": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilx2ye/ai_task_board.git",
    "directory": "packages/codex-bridge"
  },
  "homepage": "https://github.com/neilx2ye/ai_task_board#readme",
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
