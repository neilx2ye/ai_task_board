# 本地/生产 PostgreSQL 连接。开发默认用本机 Unix socket：
DATABASE_URL=postgresql:///ai_task_board_local?host=/var/run/postgresql
# 也可以走 TCP（需要已创建对应角色和密码）：
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ai_task_board

# 令牌加盐，至少 32 位随机值（可用 `openssl rand -hex 32` 生成）。
# 轮换会让现有 AI Connection 与领取令牌失效，应同时轮换连接。
AI_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# 对外服务地址，用于生成附件签名下载 URL。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 可选：本地附件存储根目录（默认是项目根下的 local-storage）。
LOCAL_STORAGE_DIR=/var/lib/ai-task-board/storage

# 可选：设为 true 时开放 /login 的注册入口。默认关闭，
# 关闭时用 `npm run user:create -- <邮箱> <密码>` 在服务端创建账号。
# ALLOW_SIGNUP=true

# 可选：文件预览页允许浏览的根目录（逗号分隔）。不配置时默认使用服务端 HOME 与工作目录。
FILE_EXPLORER_ROOTS=/home/ubuntu
